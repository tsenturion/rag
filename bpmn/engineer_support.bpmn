<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
 id="Definitions_engineer_support"
 targetNamespace="http://rag.example/engineer-support">

<bpmn:error id="INVALID_SUPPORT_REQUEST" errorCode="INVALID_SUPPORT_REQUEST" name="Invalid support request"/>

<bpmn:process id="engineer-support-process" name="Поддержка инженера" isExecutable="true">

<bpmn:startEvent id="start" name="Получен запрос"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>

<bpmn:serviceTask id="validate" name="Проверить запрос">
 <bpmn:extensionElements><zeebe:taskDefinition type="validate-support-request"/></bpmn:extensionElements>
 <bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing>
</bpmn:serviceTask>

<bpmn:boundaryEvent id="validateError" attachedToRef="validate" name="Некорректный запрос">
 <bpmn:outgoing>fErr</bpmn:outgoing>
 <bpmn:errorEventDefinition errorRef="INVALID_SUPPORT_REQUEST"/>
</bpmn:boundaryEvent>

<bpmn:serviceTask id="classify" name="Классифицировать риск">
 <bpmn:extensionElements><zeebe:taskDefinition type="classify-support-risk"/></bpmn:extensionElements>
 <bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing>
</bpmn:serviceTask>

<bpmn:exclusiveGateway id="risk" name="Высокий риск?" default="f5">
 <bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing><bpmn:outgoing>f5</bpmn:outgoing>
</bpmn:exclusiveGateway>

<bpmn:userTask id="approval" name="Ручное согласование">
 <bpmn:extensionElements>
  <zeebe:formDefinition formId="engineer-support-approval" bindingType="deployment"/>
  <zeebe:assignmentDefinition assignee="demo" candidateGroups="support-managers"/>
  <zeebe:userTask/>
 </bpmn:extensionElements>
 <bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing>
</bpmn:userTask>

<bpmn:exclusiveGateway id="approvalDecision" name="Согласовано?" default="fRejected">
 <bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>fApproved</bpmn:outgoing><bpmn:outgoing>fRejected</bpmn:outgoing>
</bpmn:exclusiveGateway>

<bpmn:exclusiveGateway id="merge">
 <bpmn:incoming>f5</bpmn:incoming><bpmn:incoming>fApproved</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing>
</bpmn:exclusiveGateway>

<bpmn:serviceTask id="agent" name="Выполнить агентный план">
 <bpmn:extensionElements><zeebe:taskDefinition type="run-support-agent"/></bpmn:extensionElements>
 <bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing>
</bpmn:serviceTask>

<bpmn:serviceTask id="verify" name="Проверить результат">
 <bpmn:extensionElements><zeebe:taskDefinition type="verify-support-result"/></bpmn:extensionElements>
 <bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing>
</bpmn:serviceTask>

<bpmn:exclusiveGateway id="verifyGateway" name="Результат принят?" default="f11">
 <bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing><bpmn:outgoing>f11</bpmn:outgoing>
</bpmn:exclusiveGateway>

<bpmn:serviceTask id="notify" name="Сообщить об ошибке">
 <bpmn:extensionElements><zeebe:taskDefinition type="notify-invalid-request"/></bpmn:extensionElements>
 <bpmn:incoming>fErr</bpmn:incoming><bpmn:outgoing>fEndErr</bpmn:outgoing>
</bpmn:serviceTask>

<bpmn:endEvent id="errorEnd" name="Запрос отклонён"><bpmn:incoming>fEndErr</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="done" name="Завершено"><bpmn:incoming>f10</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="escalated" name="Эскалация"><bpmn:incoming>f11</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="rejected" name="Согласование отклонено"><bpmn:incoming>fRejected</bpmn:incoming></bpmn:endEvent>

<bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="validate"/>
<bpmn:sequenceFlow id="f2" sourceRef="validate" targetRef="classify"/>
<bpmn:sequenceFlow id="f3" sourceRef="classify" targetRef="risk"/>
<bpmn:sequenceFlow id="f4" name="Да" sourceRef="risk" targetRef="approval"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= requiresApproval = true</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f5" name="Нет" sourceRef="risk" targetRef="merge"/>
<bpmn:sequenceFlow id="f6" sourceRef="approval" targetRef="approvalDecision"/>
<bpmn:sequenceFlow id="fApproved" name="Да" sourceRef="approvalDecision" targetRef="merge"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= approvalGranted = true</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="fRejected" name="Нет" sourceRef="approvalDecision" targetRef="rejected"/>
<bpmn:sequenceFlow id="f7" sourceRef="merge" targetRef="agent"/>
<bpmn:sequenceFlow id="f8" sourceRef="agent" targetRef="verify"/>
<bpmn:sequenceFlow id="f9" sourceRef="verify" targetRef="verifyGateway"/>
<bpmn:sequenceFlow id="f10" name="Да" sourceRef="verifyGateway" targetRef="done"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= verificationPassed = true</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f11" name="Нет" sourceRef="verifyGateway" targetRef="escalated"/>
<bpmn:sequenceFlow id="fErr" sourceRef="validateError" targetRef="notify"/>
<bpmn:sequenceFlow id="fEndErr" sourceRef="notify" targetRef="errorEnd"/>

</bpmn:process>

<bpmndi:BPMNDiagram id="Diagram">
<bpmndi:BPMNPlane id="Plane" bpmnElement="engineer-support-process">

<bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="100" y="250" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="validate_di" bpmnElement="validate"><dc:Bounds x="220" y="230" width="120" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="classify_di" bpmnElement="classify"><dc:Bounds x="420" y="230" width="140" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="risk_di" bpmnElement="risk"><dc:Bounds x="640" y="245" width="50" height="50"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="approval_di" bpmnElement="approval"><dc:Bounds x="780" y="120" width="140" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="approval_decision_di" bpmnElement="approvalDecision" isMarkerVisible="true"><dc:Bounds x="970" y="135" width="50" height="50"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="rejected_di" bpmnElement="rejected"><dc:Bounds x="1080" y="80" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="merge_di" bpmnElement="merge" isMarkerVisible="true"><dc:Bounds x="1050" y="245" width="50" height="50"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="agent_di" bpmnElement="agent"><dc:Bounds x="1140" y="230" width="140" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="verify_di" bpmnElement="verify"><dc:Bounds x="1360" y="230" width="140" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="vg_di" bpmnElement="verifyGateway"><dc:Bounds x="1580" y="245" width="50" height="50"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="done_di" bpmnElement="done"><dc:Bounds x="1740" y="200" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="esc_di" bpmnElement="escalated"><dc:Bounds x="1740" y="330" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="notify_di" bpmnElement="notify"><dc:Bounds x="430" y="430" width="150" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="err_di" bpmnElement="errorEnd"><dc:Bounds x="700" y="450" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="boundary_di" bpmnElement="validateError"><dc:Bounds x="320" y="290" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="278" y="330" width="120" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>

<bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="136" y="268"/><di:waypoint x="220" y="270"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="340" y="270"/><di:waypoint x="420" y="270"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="560" y="270"/><di:waypoint x="640" y="270"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="665" y="245"/><di:waypoint x="780" y="160"/><bpmndi:BPMNLabel><dc:Bounds x="705" y="196" width="15" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f5_di" bpmnElement="f5"><di:waypoint x="690" y="270"/><di:waypoint x="1050" y="270"/><bpmndi:BPMNLabel><dc:Bounds x="714" y="276" width="25" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f6_di" bpmnElement="f6"><di:waypoint x="920" y="160"/><di:waypoint x="970" y="160"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="fApproved_di" bpmnElement="fApproved"><di:waypoint x="995" y="185"/><di:waypoint x="995" y="220"/><di:waypoint x="1075" y="220"/><di:waypoint x="1075" y="245"/><bpmndi:BPMNLabel><dc:Bounds x="1007" y="202" width="15" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="fRejected_di" bpmnElement="fRejected"><di:waypoint x="995" y="135"/><di:waypoint x="995" y="98"/><di:waypoint x="1080" y="98"/><bpmndi:BPMNLabel><dc:Bounds x="1007" y="82" width="25" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f7_di" bpmnElement="f7"><di:waypoint x="1100" y="270"/><di:waypoint x="1140" y="270"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f8_di" bpmnElement="f8"><di:waypoint x="1280" y="270"/><di:waypoint x="1360" y="270"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f9_di" bpmnElement="f9"><di:waypoint x="1500" y="270"/><di:waypoint x="1580" y="270"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f10_di" bpmnElement="f10"><di:waypoint x="1630" y="270"/><di:waypoint x="1740" y="218"/><bpmndi:BPMNLabel><dc:Bounds x="1667" y="235" width="15" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f11_di" bpmnElement="f11"><di:waypoint x="1630" y="270"/><di:waypoint x="1740" y="348"/><bpmndi:BPMNLabel><dc:Bounds x="1667" y="310" width="25" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="fErr_di" bpmnElement="fErr"><di:waypoint x="338" y="326"/><di:waypoint x="500" y="430"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="fEndErr_di" bpmnElement="fEndErr"><di:waypoint x="580" y="470"/><di:waypoint x="700" y="468"/></bpmndi:BPMNEdge>

</bpmndi:BPMNPlane>
</bpmndi:BPMNDiagram>

</bpmn:definitions>
